---
// Set-off box for asides inside blog posts. Available in Keystatic as the
// "Inset" block; renders the {% inset %} Markdoc tag.
interface Props {
  title?: string;
}
const { title } = Astro.props;
---
<aside class="my-8 rounded-xl border-l-4 border-sand bg-bone px-6 py-5 text-[0.95em] [&>*:first-child]:mt-0! [&>*:last-child]:mb-0!">
  {title && (
    <p class="mt-0! mb-2! font-jakarta text-sm font-semibold tracking-wide text-walnut-300 uppercase">
      {title}
    </p>
  )}
  <slot />
</aside>
